{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "桌面端默认权限（macOS / Windows / Linux）",
  "platforms": ["macOS", "windows", "linux"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:default",
    "store:default",
    "log:default",
    "opener:default",
    "safe-area-insets-css-edge:default"
  ]
}
