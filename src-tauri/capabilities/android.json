{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "android-default",
  "description": "Android 端专属权限（含 SAF 文件访问）",
  "platforms": ["android"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:default",
    "store:default",
    "log:default",
    "android-fs:default",
    "opener:default",
    "safe-area-insets-css-edge:default"
  ]
}
